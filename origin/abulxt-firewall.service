[Unit]
Description=Abulxt persistent ingress firewall (amph)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# EDGE_SUBNETS lives here (written by the abulxt_origin Ansible role). Without
# it the script falls back to ashburn only, which locked the other edges out
# of Redis/9080 after a reboot and made them serve the fallback cert.
EnvironmentFile=-/etc/abulxt/firewall.env
ExecStart=/usr/local/sbin/abulxt-firewall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
