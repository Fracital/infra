 		if r.buf != nil {
@@ -60,6 +63,8 @@ func (c *wispConnection) runWriter() {
 			batchBytes += len(r.data)
 		}
 		c.pendingBytes -= batchBytes
+		// Room was made: let back-pressured stream readers queue their next frame.
+		c.egressCond().Broadcast()
 		c.pendingMutex.Unlock()
 
 		if cap(bufs) < len(batch) {
@@ -111,7 +116,37 @@ func (c *wispConnection) submitWrite(req writeReq) {
 		return
 	}
 	c.pendingMutex.Lock()
-	if c.pendingBytes+len(req.data) > c.maxPendingQueueBytes() {
+	if req.stream {
+		// Stream egress is BACK-PRESSURED, never dropped: park this stream's
+		// reader until the writer has drained enough of the queue for the
+		// frame, so the upstream TCP socket stops being read and the sender
+		// slows down (ordinary TCP flow control). Before this the queue cap
+		// below applied to DATA too and closed the WHOLE WebSocket the moment a
+		// fast origin outran the client (a 64 MiB default fills in milliseconds
+		// on a download), which killed every stream on the mux with no CLOSE
+		// packet. An empty queue always admits the frame so PendingQueueSize
+		// can never be smaller than one frame and wedge the stream. The wait
+		// releases pendingMutex; runWriter and close() broadcast egressCond.
+		for !c.isClosed.Load() && c.pendingBytes > 0 && c.pendingBytes+len(req.data) > c.maxPendingQueueBytes() {
+			c.egressCond().Wait()
+		}
+		if c.isClosed.Load() {
+			c.pendingMutex.Unlock()
+			if req.buf != nil {
+				c.config.ReadBufPool.Put(req.buf)
+			}
+			if req.done != nil {
+				req.done <- net.ErrClosed
+			}
+			return
+		}
+	} else if c.pendingBytes+len(req.data) > c.maxPendingQueueBytes()+c.maxPendingQueueBytes()/4 {
+		// Protocol control frames (CONTINUE, CLOSE, pong, INFO, WS close) are a
+		// few bytes each and must never wait behind stream data, so they bypass
+		// the back-pressure gate. Stream data is bounded at PendingQueueSize +
+		// one frame by the gate above, so this last-resort cap (25% above it)
+		// is only reachable by a control-frame flood toward a client that never
+		// reads; the connection is dropped as before.
 		c.pendingMutex.Unlock()
 		if req.buf != nil {
 			c.config.ReadBufPool.Put(req.buf)
@@ -137,8 +172,24 @@ func (c *wispConnection) queueWrite(data []byte) {
 	c.submitWrite(writeReq{data: data})
 }
 
-func (c *wispConnection) queueWritePooled(data []byte, buf *[]byte) {
-	c.submitWrite(writeReq{data: data, buf: buf})
+// queueStreamWrite queues one outbound stream DATA frame (TCP/UDP stream reads
+// and twisp pty output). Unlike queueWrite it blocks the calling stream reader
+// while the connection's egress queue is full instead of dropping the
+// connection; see submitWrite. buf, when non-nil, is a ReadBufPool buffer
+// returned once the frame is written.
+func (c *wispConnection) queueStreamWrite(data []byte, buf *[]byte) {
+	c.submitWrite(writeReq{data: data, buf: buf, stream: true})
+}
+
+// egressCond is the condition variable stream readers wait on in submitWrite
+// (predicate: room in the pending queue, or the connection closed). Created
+// lazily so test literals (&wispConnection{}) need no constructor. Caller holds
+// pendingMutex.
+func (c *wispConnection) egressCond() *sync.Cond {
+	if c.pendingCond == nil {
+		c.pendingCond = sync.NewCond(&c.pendingMutex)
+	}
+	return c.pendingCond
 }
 
 func (c *wispConnection) writeAndWait(data []byte) error {
