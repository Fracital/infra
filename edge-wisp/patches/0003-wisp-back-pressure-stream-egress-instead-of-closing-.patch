new file mode 100644
index 0000000..66cb1a0
--- /dev/null
+++ b/wisp/backpressure_test.go
@@ -0,0 +1,200 @@
+package wisp
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// Stream egress back-pressure (submitWrite): when the per-connection pending
+// write queue is full because the client is not reading, a stream's read loop
+// must PARK on its next DATA frame — not drop the whole WebSocket — and resume
+// as soon as the writer drains. Before the fix the cap closed the connection,
+// which killed every stream on the mux (no CLOSE packet) the moment a fast
+// origin outran the client, e.g. parallel large downloads.
+
+const bpFrame = 16 * 1024
+
+func newBackpressureConn(t *testing.T, queueBytes int) (*wispConnection, net.Conn) {
+	t.Helper()
+	server, client := net.Pipe()
+	pool := &sync.Pool{New: func() any { b := make([]byte, 15+bpFrame); return &b }}
+	c := &wispConnection{
+		netConn: server,
+		closeCh: make(chan struct{}),
+		config:  &Config{PendingQueueSize: queueBytes, ReadBufPool: pool},
+	}
+	t.Cleanup(func() { c.close(); client.Close() })
+	return c, client
+}
+
+// streamFrame builds a bpFrame-byte frame carrying seq in its first 4 bytes,
+// in a pooled buffer, the way readFromConnection hands frames to the writer.
+func streamFrame(c *wispConnection, seq uint32) ([]byte, *[]byte) {
+	bufp := c.config.ReadBufPool.Get().(*[]byte)
+	frame := (*bufp)[:bpFrame]
+	binary.LittleEndian.PutUint32(frame, seq)
+	return frame, bufp
+}
+
+func waitFor(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+}
+
+func TestStreamEgressBackpressureParksInsteadOfClosing(t *testing.T) {
+	const queue = 4 * bpFrame // room for 4 queued frames (+1 in the writer)
+	const total = 40
+	c, client := newBackpressureConn(t, queue)
+
+	var submitted atomic.Int32
+	go func() {
+		for seq := uint32(0); seq < total; seq++ {
+			frame, bufp := streamFrame(c, seq)
+			c.queueStreamWrite(frame, bufp) // parks while the queue is full
+			submitted.Add(1)
+		}
+	}()
+
+	// Nobody reads the client side yet: the writer blocks in its first Write
+	// (net.Pipe is synchronous) holding a batch of 1..4 frames, the next 4
+	// frames fill the queue, and the following submit must PARK: the admitted
+	// count settles between 5 and 8 and stays there. The connection must stay
+	// open.
+	waitFor(t, "queue to fill", func() bool { return submitted.Load() >= 5 })
+	time.Sleep(50 * time.Millisecond)
+	settled := submitted.Load()
+	if settled < 5 || settled > 8 {
+		t.Fatalf("submitted %d frames with a full queue, want 5..8 (writer batch + 4 queued)", settled)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if got := submitted.Load(); got != settled {
+		t.Fatalf("submits kept being admitted (%d -> %d) with nobody reading: back-pressure is not holding", settled, got)
+	}
+	if c.isClosed.Load() {
+		t.Fatalf("connection was closed by a full egress queue; stream data must back-pressure instead")
+	}
+	c.pendingMutex.Lock()
+	queued := c.pendingBytes
+	c.pendingMutex.Unlock()
+	if queued > queue {
+		t.Fatalf("pending queue %d exceeds PendingQueueSize %d", queued, queue)
+	}
+
+	// Drain the client side: every frame arrives, in order, and the parked
+	// submits resume one by one as room appears.
+	var got []byte
+	done := make(chan error, 1)
+	go func() {
+		buf := make([]byte, total*bpFrame)
+		_, err := io.ReadFull(client, buf)
+		got = buf
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("read: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("stream data did not drain after the client started reading (submitted=%d)", submitted.Load())
+	}
+	for seq := uint32(0); seq < total; seq++ {
+		if s := binary.LittleEndian.Uint32(got[int(seq)*bpFrame:]); s != seq {
+			t.Fatalf("frame %d carries seq %d: egress reordered or lost under back-pressure", seq, s)
+		}
+	}
+	if c.isClosed.Load() {
+		t.Fatalf("connection closed during a back-pressured transfer")
+	}
+}
+
+// fillAndPark submits `total` stream frames from a goroutine against a
+// connection nobody reads and returns once the admitted count has settled with
+// one submit parked (the writer holds its first batch, the queue is full).
+func fillAndPark(t *testing.T, c *wispConnection, total int) (*atomic.Int32, chan struct{}) {
+	t.Helper()
+	var submitted atomic.Int32
+	finished := make(chan struct{})
+	go func() {
+		for seq := uint32(0); seq < uint32(total); seq++ {
+			frame, bufp := streamFrame(c, seq)
+			c.queueStreamWrite(frame, bufp)
+			submitted.Add(1)
+		}
+		close(finished)
+	}()
+	waitFor(t, "queue to fill", func() bool { return submitted.Load() >= 3 })
+	settled := submitted.Load()
+	waitFor(t, "admitted count to settle", func() bool {
+		time.Sleep(30 * time.Millisecond)
+		now := submitted.Load()
+		if now == settled {
+			return true
+		}
+		settled = now
+		return false
+	})
+	if int(settled) >= total {
+		t.Fatalf("all %d frames were admitted with nobody reading: nothing parked", total)
+	}
+	if c.isClosed.Load() {
+		t.Fatalf("connection closed while filling the egress queue")
+	}
+	return &submitted, finished
+}
+
+func TestControlFramesBypassBackpressure(t *testing.T) {
+	const queue = 2 * bpFrame
+	c, _ := newBackpressureConn(t, queue)
+	fillAndPark(t, c, 16)
+	c.pendingMutex.Lock()
+	queuedBefore := len(c.pendingWrites)
+	c.pendingMutex.Unlock()
+
+	// A CLOSE / CONTINUE must be queued immediately, behind the data, without
+	// parking and without tripping the last-resort cap.
+	ret := make(chan struct{})
+	go func() {
+		c.sendClosePacket(7, closeReasonVoluntary)
+		c.sendPacket(7, 32)
+		close(ret)
+	}()
+	select {
+	case <-ret:
+	case <-time.After(time.Second):
+		t.Fatalf("control frame blocked behind a full stream egress queue")
+	}
+	if c.isClosed.Load() {
+		t.Fatalf("control frame on a full queue closed the connection")
+	}
+	c.pendingMutex.Lock()
+	n := len(c.pendingWrites)
+	c.pendingMutex.Unlock()
+	if n != queuedBefore+2 { // the queued data frames + CLOSE + CONTINUE
+		t.Fatalf("pending writes = %d, want %d (queued data + 2 control)", n, queuedBefore+2)
+	}
+}
+
+func TestParkedStreamWriterWakesOnClose(t *testing.T) {
+	const queue = 2 * bpFrame
+	c, _ := newBackpressureConn(t, queue)
+	_, finished := fillAndPark(t, c, 16)
+
+	c.close()
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatalf("stream reader stayed parked after the connection closed")
+	}
+}
