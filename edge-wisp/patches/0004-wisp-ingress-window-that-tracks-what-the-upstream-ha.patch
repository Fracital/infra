+// ingressDrained records that n queued DATA packets reached the upstream and
+// replenishes the client's window with a CONTINUE once at least half the
+// window has been freed since the last advertisement (hysteresis keeps CONTINUE
+// traffic to a few packets per window, and the client is only ever blocked
+// while more than half a window is still queued here), and whenever the queue
+// has fully drained while the client holds less than the whole window — so a
+// client can never be left waiting on an empty queue, whatever the mirror of
+// its budget says. The advertised value is absolute: window minus what is
+// still in flight.
+func (s *wispStream) ingressDrained(n int) {
+	window := s.wispConn.ingressWindow()
+	step := window / 2
+	if step < 1 {
+		step = 1
+	}
+	s.pendingIngMu.Lock()
+	if uint32(n) <= s.ingressInflight {
+		s.ingressInflight -= uint32(n)
+	} else {
+		s.ingressInflight = 0
+	}
+	var avail uint32
+	if s.ingressInflight < window {
+		avail = window - s.ingressInflight
+	}
+	var announce uint32
+	if avail >= s.ingressAdvertised+step || (s.ingressInflight == 0 && s.ingressAdvertised < window) {
+		s.ingressAdvertised = avail
+		announce = avail
+	}
+	s.pendingIngMu.Unlock()
+	if announce > 0 && s.isOpen.Load() {
+		s.wispConn.sendPacket(s.streamId, announce)
 	}
 }
 
@@ -390,6 +427,12 @@ func (s *wispStream) submitIngress(job ingressJob) bool {
 	}
 	s.pendingIngress = append(s.pendingIngress, job)
 	s.pendingIngBytes += len(job.payload)
+	// Window accounting (see ingressDrained): one more packet in flight, one
+	// less in the budget the client believes it has.
+	s.ingressInflight++
+	if s.ingressAdvertised > 0 {
+		s.ingressAdvertised--
+	}
 	if s.ingressWriting {
 		s.pendingIngMu.Unlock()
 		return true
