+// ingressWindow is the client->server flow-control window advertised in
+// CONTINUE packets (initial stream 0, stream confirm, and replenishment): the
+// number of DATA packets the client may have in flight toward one stream.
+// Wisp counts the window in packets, but each packet can be up to
+// maxPayloadSize, so a window of BufferRemainingLength (32768 by default) could
+// stand for gigabytes and the per-stream ingress queue cap (PendingQueueSize)
+// was always hit first. The window is therefore also bounded so a full window
+// of maximum-size packets fits in half the queue; replenishment then keeps the
+// queue bounded without ever closing the stream.
+func (c *wispConnection) ingressWindow() uint32 {
+	w := uint32(32768)
+	if c != nil && c.config != nil && c.config.BufferRemainingLength > 0 {
+		w = c.config.BufferRemainingLength
+	}
+	byMem := c.maxPendingQueueBytes() / 2 / int(c.maxPayloadSize())
+	if byMem < 1 {
+		byMem = 1
+	}
+	if uint32(byMem) < w {
+		w = uint32(byMem)
+	}
+	return w
+}
+
