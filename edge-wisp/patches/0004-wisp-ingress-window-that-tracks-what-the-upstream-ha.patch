+package wisp
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Client->server flow control: the CONTINUE window a stream advertises must
+// track what the ingress writer has actually delivered upstream. While the
+// upstream is stalled no CONTINUE may be sent (the client stays blocked at a
+// zero budget instead of filling the per-stream queue until the cap closes the
+// stream with 0x49); once the upstream drains, the budget is replenished.
+
+// readContinues parses unmasked server WebSocket frames off the WS side of a
+// wispConnection and reports every CONTINUE's (streamId, bufferRemaining).
+func readContinues(t *testing.T, ws net.Conn, out chan<- [2]uint32) {
+	t.Helper()
+	hdr := make([]byte, 2)
+	for {
+		if _, err := io.ReadFull(ws, hdr); err != nil {
+			return
+		}
+		l := uint64(hdr[1] & 0x7f)
+		switch l {
+		case 126:
+			var b [2]byte
+			if _, err := io.ReadFull(ws, b[:]); err != nil {
+				return
+			}
+			l = uint64(binary.BigEndian.Uint16(b[:]))
+		case 127:
+			var b [8]byte
+			if _, err := io.ReadFull(ws, b[:]); err != nil {
+				return
+			}
+			l = binary.BigEndian.Uint64(b[:])
+		}
+		p := make([]byte, l)
+		if _, err := io.ReadFull(ws, p); err != nil {
+			return
+		}
+		if hdr[0]&0x0f == 0x2 && len(p) == 9 && p[0] == packetTypeContinue {
+			out <- [2]uint32{binary.LittleEndian.Uint32(p[1:5]), binary.LittleEndian.Uint32(p[5:9])}
+		}
+	}
+}
+
+func TestIngressWindowReplenishesOnlyAsUpstreamDrains(t *testing.T) {
+	wsServer, wsClient := net.Pipe()
+	upServer, upClient := net.Pipe()
+	pool := &sync.Pool{New: func() any { b := make([]byte, 15+DefaultMaxPayloadSize); return &b }}
+	// PendingQueueSize = 8 max packets -> window = 8/2 = 4 packets.
+	c := &wispConnection{
+		netConn: wsServer,
+		closeCh: make(chan struct{}),
+		config:  &Config{PendingQueueSize: 8 * DefaultMaxPayloadSize, BufferRemainingLength: 32768, ReadBufPool: pool},
+	}
+	t.Cleanup(func() { c.close(); wsClient.Close(); upClient.Close() })
+	window := c.ingressWindow()
+	if window != 4 {
+		t.Fatalf("ingressWindow = %d, want 4 (half of an 8-packet queue)", window)
+	}
+
+	continues := make(chan [2]uint32, 64)
+	go readContinues(t, wsClient, continues)
+
+	s := &wispStream{wispConn: c, streamId: 1, streamType: streamTypeTCP, conn: upServer, connReady: make(chan struct{}), pendingIngress: make([]ingressJob, 0, 16)}
+	s.isOpen.Store(true)
+	s.connReadyDone.Store(true)
+	s.ingressActive.Store(true)
+	s.bufferRemaining = window
+	s.ingressAdvertised = window
+	c.streams.Store(s.streamId, s)
+
+	const pkt = 1000
+	payload := func(b byte) []byte {
+		p := make([]byte, pkt)
+		for i := range p {
+			p[i] = b
+		}
+		return p
+	}
+	// The client spends its whole window; the upstream (upClient) reads nothing.
+	for i := 0; i < int(window); i++ {
+		c.handleDataPacket(s.streamId, payload(byte('a'+i)), nil)
+	}
+	select {
+	case got := <-continues:
+		t.Fatalf("CONTINUE %v sent while the upstream was stalled: the client would keep sending into a queue nobody drains", got)
+	case <-time.After(80 * time.Millisecond):
+	}
+	if !s.isOpen.Load() || c.isClosed.Load() {
+		t.Fatalf("stream or connection closed while the window was merely full")
+	}
+
+	// drainPhase reads one full window off the upstream and collects the
+	// CONTINUEs that follow. The writer may deliver the window in several
+	// batches, so there can be more than one announcement; each is an absolute
+	// budget that must stay within the window and never shrink, and the last
+	// one must hand the whole window back.
+	buf := make([]byte, int(window)*pkt)
+	drainPhase := func(phase string) {
+		if _, err := io.ReadFull(upClient, buf); err != nil {
+			t.Fatalf("%s: upstream read: %v", phase, err)
+		}
+		var seen []uint32
+		deadline := time.After(time.Second)
+		for {
+			select {
+			case got := <-continues:
+				if got[0] != s.streamId {
+					t.Fatalf("%s: CONTINUE for stream %d, want %d", phase, got[0], s.streamId)
+				}
+				if got[1] > window || (len(seen) > 0 && got[1] < seen[len(seen)-1]) {
+					t.Fatalf("%s: CONTINUE advertised %d after %v (window %d)", phase, got[1], seen, window)
+				}
+				seen = append(seen, got[1])
+				if got[1] == window {
+					return
+				}
+			case <-deadline:
+				t.Fatalf("%s: window not handed back after the upstream drained (CONTINUEs seen: %v): the client would stay blocked", phase, seen)
+			}
+		}
+	}
+	drainPhase("first drain")
+
+	// A second window round-trips the same way (the accounting does not drift).
+	for i := 0; i < int(window); i++ {
+		c.handleDataPacket(s.streamId, payload('z'), nil)
+	}
+	select {
+	case got := <-continues:
+		t.Fatalf("CONTINUE %v sent with the upstream stalled again", got)
+	case <-time.After(80 * time.Millisecond):
+	}
+	drainPhase("second drain")
+}
+
+// Packets the client sends before CONNECT completes (a TLS ClientHello is the
+// normal case) are buffered and flushed straight to the upstream, bypassing
+// the ingress queue. They still spent the client's budget, so the mirror must
+// count them or the server could withhold a replenishment the client needs.
+func TestIngressWindowCountsPacketsSentBeforeConnect(t *testing.T) {
+	wsServer, wsClient := net.Pipe()
+	upServer, upClient := net.Pipe()
+	pool := &sync.Pool{New: func() any { b := make([]byte, 15+DefaultMaxPayloadSize); return &b }}
+	c := &wispConnection{
+		netConn: wsServer,
+		closeCh: make(chan struct{}),
+		config:  &Config{PendingQueueSize: 8 * DefaultMaxPayloadSize, BufferRemainingLength: 32768, ReadBufPool: pool},
+	}
+	t.Cleanup(func() { c.close(); wsClient.Close(); upClient.Close() })
+	window := c.ingressWindow() // 4
+	continues := make(chan [2]uint32, 64)
+	go readContinues(t, wsClient, continues)
+
+	// Exactly what handleConnectPacket builds, before handleConnect has run.
+	s := &wispStream{wispConn: c, streamId: 1, connReady: make(chan struct{}), pendingIngress: make([]ingressJob, 0, 16), ingressAdvertised: window}
+	s.isOpen.Store(true)
+	c.streams.Store(s.streamId, s)
+
+	const pkt = 1000
+	payload := make([]byte, pkt)
+	// Client sends 3 of its 4 packets before the dial completes.
+	for i := 0; i < 3; i++ {
+		c.handleDataPacket(s.streamId, payload, nil)
+	}
+	// Dial completes: flush the buffered packets (someone reads them) and mark
+	// the stream ready, as handleConnect does.
+	s.conn = upServer
+	s.streamType = streamTypeTCP
+	s.bufferRemaining = window
+	go func() { io.ReadFull(upClient, make([]byte, 3*pkt)) }()
+	if err := s.flushPendingAndMarkReady(streamTypeTCP); err != nil {
+		t.Fatalf("flush: %v", err)
+	}
+	// Client spends its last packet; it is now blocked at a zero budget.
+	c.handleDataPacket(s.streamId, payload, nil)
+	if _, err := io.ReadFull(upClient, make([]byte, pkt)); err != nil {
+		t.Fatalf("upstream read: %v", err)
+	}
+	select {
+	case got := <-continues:
+		if got[1] != window {
+			t.Fatalf("CONTINUE advertised %d after a full drain, want the whole window %d", got[1], window)
+		}
+	case <-time.After(time.Second):
+		t.Fatalf("no CONTINUE after the upstream drained: packets sent before CONNECT were not counted and the client is stuck")
+	}
+}
