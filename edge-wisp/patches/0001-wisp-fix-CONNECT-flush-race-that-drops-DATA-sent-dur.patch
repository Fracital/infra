index 5a3ebcb..600892f 100644
--- a/wisp/wisp-stream.go
+++ b/wisp/wisp-stream.go
@@ -2,6 +2,7 @@ package wisp
 
 import (
 	"context"
+	"errors"
 	"io"
 	"net"
 	"strings"
@@ -270,31 +271,50 @@ func (s *wispStream) handleConnect(streamType uint8, port string, hostname strin
 		s.wispConn.sendPacket(s.streamId, s.bufferRemaining)
 	}
 
-	s.pendingMutex.Lock()
-	pending := s.pendingData
-	s.pendingData = nil
-	s.pendingBytes = 0
-	s.pendingMutex.Unlock()
-
-	for _, data := range pending {
-		if !s.isOpen.Load() {
-			return
-		}
-		if err := writeAll(s.conn, data); err != nil {
-			s.close(closeReasonNetworkError)
-			return
-		}
-	}
-
-	if streamType == streamTypeTCP {
-		s.ingressActive.Store(true)
+	if err := s.flushPendingAndMarkReady(streamType); err != nil {
+		s.close(closeReasonNetworkError)
+		return
 	}
 
-	s.signalConnReady()
-
 	s.readFromConnection()
 }
 
+// flushPendingAndMarkReady writes the DATA that handleDataPacket buffered while
+// CONNECT was still in progress, then marks the stream ready so the read path
+// takes over. handleDataPacket keeps appending to pendingData until
+// connReadyDone is set, and it can do so while the writes below are in flight.
+// So the flush re-checks under pendingMutex until the queue is empty, and sets
+// connReadyDone (and ingressActive) under that same lock. Nothing can be
+// appended after the final check.
+func (s *wispStream) flushPendingAndMarkReady(streamType uint8) error {
+	for {
+		s.pendingMutex.Lock()
+		if len(s.pendingData) == 0 {
+			if streamType == streamTypeTCP {
+				s.ingressActive.Store(true)
+			}
+			s.signalConnReady()
+			s.pendingMutex.Unlock()
+			return nil
+		}
+		pending := s.pendingData
+		s.pendingData = nil
+		s.pendingBytes = 0
+		s.pendingMutex.Unlock()
+
+		for _, data := range pending {
+			if !s.isOpen.Load() {
+				return errStreamClosedDuringFlush
+			}
+			if err := writeAll(s.conn, data); err != nil {
+				return err
+			}
+		}
+	}
+}
+
+var errStreamClosedDuringFlush = errors.New("wisp stream closed during pending-data flush")
+
 func (s *wispStream) runIngressWriter() {
 	var bufs net.Buffers
 	var jobs []ingressJob
