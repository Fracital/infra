# Proxy settings for the Fracital locations (30-fracital.conf). Managed by Ansible
# (edge_relay role). Holds the edge token: mode 0640.
proxy_pass https://fracital_origin;
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header Upgrade $ws_upgrade;
proxy_set_header Connection $fracital_connection;

# $remote_addr is the end client (realip already rewrote it for Cloudflare ranges).
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host "";
proxy_set_header CF-Connecting-IP "";
proxy_set_header X-FRX-Edge-Token "{{ fracital_origin_token }}";

# TLS to terp: only its pinned self-signed certificate (roles/edge_relay/files/fracital-origin.crt).
proxy_ssl_server_name on;
proxy_ssl_name {{ fracital_origin_sni }};
proxy_ssl_verify on;
proxy_ssl_verify_depth 1;
proxy_ssl_trusted_certificate {{ openresty_conf_dir }}/fracital-origin.crt;
proxy_ssl_protocols TLSv1.2 TLSv1.3;
proxy_ssl_session_reuse on;

proxy_connect_timeout {{ edge_proxy_connect_timeout }};
proxy_next_upstream off;
