# --- mcnode.abstracteducation.loan → Pterodactyl Wings daemon (HTTPS :8080) ---
# Wings terminates its own TLS with the mcnode cert, so we HTTPS-proxy through.
server {
    listen 80;
    listen [::]:80;
    server_name mcnode.abstracteducation.loan;

    location /.well-known/acme-challenge/ {
        content_by_lua_block {
            auto_ssl_instance:challenge_server()
        }
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
{% if edge_front_listen %}
    listen unix:{{ edge_front_socket }};
{% endif %}
{% if edge_tcp8080_split | bool %}
    # :8080 belongs to the stream SNI split (nginx.conf), which hands this name over here.
    listen {{ edge_tcp8080_local }} ssl;
{% else %}
    listen 8080 ssl;
    listen [::]:8080 ssl;
{% endif %}
    http2 {{ 'on' if (openresty_http2 | default(false) | bool) else 'off' }};
    server_name mcnode.abstracteducation.loan;
    # Panel file uploads (mods, worlds) POST straight to Wings. No proxy cap here: Wings enforces its own
    # api.upload_limit (MB, /etc/pterodactyl/config.yml on eagler, the node's "Upload limit" in the panel).
    # nginx's 1 MB default answered 413 to every mod upload (2026-11-13).
    client_max_body_size 0;

    ssl_certificate_by_lua_block {
        auto_ssl_instance:ssl_certificate()
    }
    ssl_certificate {{ openresty_auto_ssl_dir }}/fallback.crt;
    ssl_certificate_key {{ openresty_auto_ssl_dir }}/fallback.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass {{ wings_upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $edge_scheme;
        proxy_set_header Upgrade $ws_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_ssl_server_name on;
        proxy_ssl_name $host;

        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        proxy_connect_timeout 10s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

# Catch-all for :8080 (or, with the SNI split, its local vhost) so unknown Host headers never
# reach Wings.
server {
{% if edge_tcp8080_split | bool %}
    listen {{ edge_tcp8080_local }} ssl default_server;
{% else %}
    listen 8080 ssl default_server;
    listen [::]:8080 ssl default_server;
{% endif %}
    server_name _;

    ssl_certificate {{ openresty_auto_ssl_dir }}/fallback.crt;
    ssl_certificate_key {{ openresty_auto_ssl_dir }}/fallback.key;

    return 444;
}
