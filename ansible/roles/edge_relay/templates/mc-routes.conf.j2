# Eaglercraft / MC panel subdomain routes. Managed by Ansible (edge_relay role).
# These host-specific server blocks take precedence over the 00-edge-relay
# catch-all (nginx matches server_name before default_server), so the mc
# subdomains reach the Eaglercraft backend instead of the abulxt SPA.
#
# TLS for these names is issued on demand via the shared auto-ssl store, gated
# by amph's abulxt-domains validator (target=edge): both CNAME to
# byod.abstracteducation.loan, whose DNS resolves to edge IPs, so they approve.

# --- mcpanel.abstracteducation.loan → panel web UI (HTTPS backend :443) ---
server {
    listen 80;
    listen [::]:80;
    server_name mcpanel.abstracteducation.loan;

    location /.well-known/acme-challenge/ {
        content_by_lua_block {
            auto_ssl_instance:challenge_server()
        }
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
{% if edge_front_listen %}
    listen unix:{{ edge_front_socket }};
{% endif %}
    http2 {{ 'on' if (openresty_http2 | default(false) | bool) else 'off' }};
    server_name mcpanel.abstracteducation.loan;

    ssl_certificate_by_lua_block {
        auto_ssl_instance:ssl_certificate()
    }
    ssl_certificate {{ openresty_auto_ssl_dir }}/fallback.crt;
    ssl_certificate_key {{ openresty_auto_ssl_dir }}/fallback.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass {{ eaglercraft_panel_upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $edge_scheme;
        proxy_set_header Upgrade $ws_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_ssl_server_name on;
        proxy_ssl_name $host;

        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        proxy_connect_timeout 10s;
        proxy_buffering off;
    }
}

