# Managed by Ansible (openresty role, tasks/isolation.yml; defaults openresty_rw_paths).
# The master is root (ports, keys) and starts its workers as {{ openresty_user }}:{{ openresty_group }} (nginx.conf
# `user`). This keeps the whole service, master included, inside a sandbox.
[Service]
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Bind :80/:443, become the worker user, own and signal the workers, read root's keys, raise the
# open-files limit. Nothing else (no NET_ADMIN, SYS_ADMIN, SYS_PTRACE, ...), workers have none.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_KILL CAP_SYS_RESOURCE
ReadWritePaths={% for p in openresty_rw_paths %}-{{ p }}{{ ' ' if not loop.last else '' }}{% endfor %}

