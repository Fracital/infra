# terp OpenResty. Managed by Ansible (abulxt fracital_origin role). Local edits are overwritten.

user www-data;
worker_processes auto;
worker_rlimit_nofile 16384;
pid {{ fracital_openresty_prefix }}/nginx/logs/nginx.pid;
error_log {{ fracital_openresty_prefix }}/nginx/logs/error.log warn;

events {
    worker_connections 8192;
    multi_accept on;
    use epoll;
}

http {
    include {{ fracital_openresty_conf_dir }}/mime.types;
    default_type application/octet-stream;

    log_format origin_combined '$remote_addr "$http_x_real_ip" [$time_local] '
                               '"$request" $status $body_bytes_sent '
                               '"$http_referer" "$http_user_agent" '
                               'rt=$request_time urt="$upstream_response_time" host="$host"';
    access_log {{ fracital_openresty_prefix }}/nginx/logs/access.log origin_combined;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 10000;
    types_hash_max_size 2048;
    server_names_hash_bucket_size 64;
    server_tokens off;

    # Compress here, before the long edge legs (the edges' gzip skips a response that already has
    # Content-Encoding). Neither app compresses itself: Fracital (Hono) and stomp send identity
    # bodies. gzip skips responses that carry Content-Encoding, and 206/304s; it weakens a strong
    # ETag (stomp's are weak already, Fracital sends Last-Modified only). gzip_proxied any: the
    # requests arrive through the edges and may carry Via. application/wasm is safe to encode
    # (instantiateStreaming accepts it; Cloudflare already serves it to clients with br).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript
               application/x-javascript application/json application/manifest+json
               application/xml image/svg+xml application/wasm;

    map $http_upgrade $ws_upgrade {
        ~*^websocket$ $http_upgrade;
        default       "";
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream fracital_app {
        server 127.0.0.1:{{ fracital_app_port }};
        keepalive 64;
    }
{% for app in fracital_origin_apps | default([]) %}

    upstream {{ app.name }}_app {
        server 127.0.0.1:{{ app.port }};
        keepalive 64;
    }
{% endfor %}

    # The app the edge asks for on the default server (conf.d/10-fracital.conf): a domain staff
    # registered for stomp has no server_name here, so the edge's link routing names the app in
    # X-FRX-App. Read only after the edge token check. Anything else is Fracital.
    map $http_x_frx_app $frx_app_upstream {
        default fracital_app;
{% for app in fracital_origin_apps | default([]) %}
        {{ app.name }} {{ app.name }}_app;
{% endfor %}
    }

    include {{ fracital_openresty_conf_dir }}/conf.d/*.conf;
}
