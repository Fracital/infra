#!/bin/sh
# Managed by Ansible (abulxt roles/edge_warp). Turns kernel-mode WARP off on this box:
# moves the networkd files for warp* aside, deletes the tunnels and removes their ip
# rules. The identities in /etc/abulxt/warp/ stay; re-running the role brings it all
# back. The dead-man switch (edge-warp-deadman.timer) runs this when a rollout isn't
# confirmed from outside.
#
# edge-router.py keeps its config: its probes then fail and it sends clean streams
# directly (warp_fallback_direct) or fails them. To stop it marking, set
# edge_warp_enabled: false and run the wisp tag (README.md "Cloudflare WARP").
set -u
off=/etc/abulxt/warp/off
mkdir -p "$off"
chmod 0700 /etc/abulxt/warp "$off"
for f in /etc/systemd/network/50-warp*.netdev /etc/systemd/network/50-warp*.network /etc/systemd/network/50-warp*.key; do
	[ -e "$f" ] && mv -f "$f" "$off/"
done
timeout 30 networkctl reload
for link in /sys/class/net/warp*; do
	[ -e "$link" ] || continue
	timeout 10 ip link delete "${link##*/}"
done
# networkd drops its rules with the links. Anything left at the WARP priorities goes;
# a fixed number of tries per priority, never an open loop.
# (The own-address drop-ins in 50-warp*.network.d/ stay: without their .network they do nothing.)
for prio in {% if not (edge_public_ip_on_box | bool) %}{{ edge_warp_own_address_priority }} {% endif %}{% for i in range(edge_warp_tunnel_count | int) %}{{ edge_warp_mark_base | int + 1 + i }} {% endfor %}{{ edge_warp_mark_base | int + 128 }}; do
	for fam in -4 -6; do
		for _ in 1 2 3; do
			ip "$fam" rule del priority "$prio" 2>/dev/null || break
		done
	done
done
echo "edge-warp-off: tunnels off; networkd files in $off"
